{
    "actorSpecification": 1,
    "name": "misumi-usa-scraper",
    "title": "MISUMI USA Parts Price, Lead-Time & Stock Scraper",
    "description": "Extract public catalog unit prices, lead times (days to ship), stock status, MOQ, specs, and 2D/3D CAD availability from MISUMI USA (us.misumi-ec.com) by part number, keyword, or URL.",
    "version": "0.1",
    "meta": {
        "templateId": "python-playwright"
    },
    "input": "./input_schema.json",
    "dockerfile": "../Dockerfile",
    "storages": {
        "dataset": {
            "actorSpecification": 1,
            "fields": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                    "querySource": { "type": ["string", "null"], "title": "Query / Input" },
                    "partNumber": { "type": ["string", "null"], "title": "Part Number" },
                    "seriesCode": { "type": ["string", "null"], "title": "Series Code" },
                    "productName": { "type": ["string", "null"], "title": "Product Name" },
                    "brand": { "type": ["string", "null"], "title": "Brand" },
                    "category": { "type": ["string", "null"], "title": "Category" },
                    "unitPriceUSD": { "type": ["number", "null"], "title": "Unit Price (USD)" },
                    "currency": { "type": ["string", "null"], "title": "Currency" },
                    "daysToShip": { "type": ["integer", "null"], "title": "Days to Ship" },
                    "inStock": { "type": ["boolean", "null"], "title": "Quick Ship / Stock" },
                    "minOrderQty": { "type": ["integer", "null"], "title": "MOQ" },
                    "cadAvailable": { "type": ["boolean", "null"], "title": "2D/3D CAD" },
                    "specsSummary": { "type": ["string", "null"], "title": "Key Specs" },
                    "imageUrl": { "type": ["string", "null"], "title": "Image URL" },
                    "url": { "type": ["string", "null"], "title": "Catalog URL" },
                    "scrapedAt": { "type": ["string", "null"], "title": "Checked At (UTC)" }
                }
            },
            "views": {
                "overview": {
                    "title": "Procurement & Cross-Reference Sheet",
                    "transformation": {
                        "fields": [
                            "partNumber",
                            "productName",
                            "brand",
                            "unitPriceUSD",
                            "daysToShip",
                            "inStock",
                            "minOrderQty",
                            "cadAvailable",
                            "specsSummary",
                            "url"
                        ]
                    },
                    "display": {
                        "component": "table",
                        "properties": {
                            "partNumber": { "label": "Part Number", "format": "text" },
                            "productName": { "label": "Product Name", "format": "text" },
                            "brand": { "label": "Brand", "format": "text" },
                            "unitPriceUSD": { "label": "Unit Price ($)", "format": "number" },
                            "daysToShip": { "label": "Days to Ship", "format": "number" },
                            "inStock": { "label": "Fast Ship", "format": "boolean" },
                            "minOrderQty": { "label": "MOQ", "format": "number" },
                            "cadAvailable": { "label": "CAD", "format": "boolean" },
                            "specsSummary": { "label": "Specs Summary", "format": "text" },
                            "url": { "label": "Product Link", "format": "link" }
                        }
                    }
                }
            }
        }
    }
}
